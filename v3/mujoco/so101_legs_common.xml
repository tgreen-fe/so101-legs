<mujoco>
  <!-- Generated by build_model.py. Shared defaults, assets, actuators and sensors. -->
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <!-- STS3215 12V 1/345 (SO-101 follower): ~2.9 Nm stall -->
    <default class="sts3215_345">
      <joint damping="0.6" armature="0.028" frictionloss="0.052"/>
      <position kp="17.8" kv="0" forcerange="-2.94 2.94"/>
    </default>
    <!-- STS3215 7.4V 1/191 (SO-101 leader): torque scaled from 1/345 by gear ratio, ~1.06 Nm -->
    <default class="sts3215_191">
      <joint damping="0.33" armature="0.0086" frictionloss="0.029"/>
      <position kp="9.9" kv="0" forcerange="-1.06 1.06"/>
    </default>
    <default class="visual_printed">
      <geom type="mesh" contype="0" conaffinity="0" group="2" rgba="0.92 0.55 0.2 1"/>
    </default>
    <default class="visual_servo">
      <geom type="mesh" contype="0" conaffinity="0" group="2" rgba="0.15 0.15 0.15 1"/>
    </default>
    <default class="collision">
      <geom type="mesh" contype="1" conaffinity="0" group="3" mass="0" rgba="0.5 0.5 1 0.3"/>
    </default>
    <default class="foot">
      <!-- feet collide with floor and each other -->
      <geom contype="3" conaffinity="2" group="3" mass="0" friction="0.8 0.02 0.001" condim="4" rgba="0.5 0.5 1 0.3"/>
    </default>
  </default>

  <asset>
    <mesh name="pelvis_printed" file="pelvis_printed.stl" inertia="shell"/>
    <mesh name="pelvis_servo" file="pelvis_servo.stl" inertia="convex"/>
    <mesh name="hip_L_printed" file="hip_L_printed.stl" inertia="shell"/>
    <mesh name="hip_L_servo" file="hip_L_servo.stl" inertia="convex"/>
    <mesh name="hip_R_printed" file="hip_R_printed.stl" inertia="shell"/>
    <mesh name="hip_R_servo" file="hip_R_servo.stl" inertia="convex"/>
    <mesh name="thigh_L_printed" file="thigh_L_printed.stl" inertia="shell"/>
    <mesh name="thigh_L_servo" file="thigh_L_servo.stl" inertia="convex"/>
    <mesh name="thigh_R_printed" file="thigh_R_printed.stl" inertia="shell"/>
    <mesh name="thigh_R_servo" file="thigh_R_servo.stl" inertia="convex"/>
    <mesh name="shank_L_printed" file="shank_L_printed.stl" inertia="shell"/>
    <mesh name="shank_L_servo" file="shank_L_servo.stl" inertia="convex"/>
    <mesh name="shank_R_printed" file="shank_R_printed.stl" inertia="shell"/>
    <mesh name="shank_R_servo" file="shank_R_servo.stl" inertia="convex"/>
    <mesh name="foot_L_printed" file="foot_L_printed.stl" inertia="shell"/>
    <mesh name="foot_R_printed" file="foot_R_printed.stl" inertia="shell"/>
  </asset>

  <actuator>
    <position name="hip_yaw_L" joint="hip_yaw_L" class="sts3215_191" inheritrange="1"/>
    <position name="hip_pitch_L" joint="hip_pitch_L" class="sts3215_345" inheritrange="1"/>
    <position name="knee_L" joint="knee_L" class="sts3215_345" inheritrange="1"/>
    <position name="ankle_L" joint="ankle_L" class="sts3215_345" inheritrange="1"/>
    <position name="hip_yaw_R" joint="hip_yaw_R" class="sts3215_191" inheritrange="1"/>
    <position name="hip_pitch_R" joint="hip_pitch_R" class="sts3215_345" inheritrange="1"/>
    <position name="knee_R" joint="knee_R" class="sts3215_345" inheritrange="1"/>
    <position name="ankle_R" joint="ankle_R" class="sts3215_345" inheritrange="1"/>
  </actuator>

  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acc" site="imu"/>
    <velocimeter name="imu_vel" site="imu"/>
    <touch name="foot_touch_L" site="foot_L"/>
    <touch name="foot_touch_R" site="foot_R"/>
    <jointpos name="hip_yaw_L_pos" joint="hip_yaw_L"/>
    <jointpos name="hip_pitch_L_pos" joint="hip_pitch_L"/>
    <jointpos name="knee_L_pos" joint="knee_L"/>
    <jointpos name="ankle_L_pos" joint="ankle_L"/>
    <jointpos name="hip_yaw_R_pos" joint="hip_yaw_R"/>
    <jointpos name="hip_pitch_R_pos" joint="hip_pitch_R"/>
    <jointpos name="knee_R_pos" joint="knee_R"/>
    <jointpos name="ankle_R_pos" joint="ankle_R"/>
  </sensor>
</mujoco>
